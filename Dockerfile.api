# SYNERA API image. The data, database and ledger are built INTO the image (the build step below), so the container starts
# small and fast: on a 512 MB host the first-start data build (~730 MB peak) would otherwise be killed. This means the ledger
# signing key lives in this private image layer, so never push the image to a public registry. In docker compose the
# artifacts volume is initialised from the image on first use and keeps the key and ledger afterwards.
FROM python:3.11-slim AS base
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 PIP_NO_CACHE_DIR=1 OMP_NUM_THREADS=1 SYNERA_ROOT=/app PYTHONPATH=/app/src
WORKDIR /app
RUN apt-get update && apt-get install -y --no-install-recommends libgomp1 git && rm -rf /var/lib/apt/lists/*
COPY pyproject.toml README.md ./
COPY src ./src
RUN pip install --extra-index-url https://download.pytorch.org/whl/cpu torch && pip install ".[api,ml]"
COPY backend ./backend
COPY configs ./configs
COPY scripts ./scripts
COPY data ./data
RUN useradd --create-home --uid 10001 synera && mkdir -p /app/artifacts && chown -R synera /app
USER synera
RUN python scripts/bootstrap.py --quick
EXPOSE 8000
HEALTHCHECK --interval=20s --timeout=5s --start-period=40s --retries=5 \
  CMD python -c "import os,urllib.request,sys; sys.exit(0 if urllib.request.urlopen('http://127.0.0.1:%s/api/v1/health'%os.environ.get('PORT','8000'),timeout=4).status==200 else 1)"
CMD ["sh", "-c", "[ -f artifacts/synera.db ] || python scripts/bootstrap.py --quick; uvicorn backend.app.main:app --host 0.0.0.0 --port ${PORT:-8000}"]

