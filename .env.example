SYNERA_ENV=dev
API_HOST=127.0.0.1
API_PORT=8000
# Comma-separated list of allowed browser origins
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# 1 = use only cached raw files and cached forecasts (the risk page shows an OFFLINE / CACHED tag)
SYNERA_OFFLINE=0
# Override the application database location (tests)
# SYNERA_DB_PATH=artifacts/synera.db
